AIRFLOW_VERSION=3.1.8
AIRFLOW_UID=50000
AIRFLOW_UI_PORT=8081
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=change-me-local-only
AIRFLOW_METADATA_DB=airflow_metadata
AIRFLOW_METADATA_USER=airflow
AIRFLOW_METADATA_PASSWORD=change-me-local-only
AIRFLOW_API_JWT_SECRET=change-me-with-a-long-random-value
AIRFLOW_SOURCE_DATABASE_URL=mysql+pymysql://app:change-me@host.docker.internal:3306/app?charset=utf8mb4
COMDELY_DW_SCHEDULE=0 2 * * *
ELT_BATCH_SIZE=500
ELT_SOURCE_SYSTEM=comdely_mariadb
ELT_SOURCE_TIMEZONE=Africa/Tunis
