comdely_warehouse:
  target: dev
  outputs:
    dev:
      type: postgres
      host: "{{ env_var('DBT_POSTGRES_HOST', '127.0.0.1') }}"
      port: "{{ env_var('DBT_POSTGRES_PORT', '5433') | int }}"
      user: "{{ env_var('DBT_POSTGRES_USER', 'comdely_dw') }}"
      password: "{{ env_var('DBT_POSTGRES_PASSWORD') }}"
      dbname: "{{ env_var('DBT_POSTGRES_DB', 'comdely_dw') }}"
      schema: "{{ env_var('DBT_POSTGRES_SCHEMA', 'analytics') }}"
      threads: "{{ env_var('DBT_THREADS', '4') | int }}"
      connect_timeout: 10
      retries: 2
