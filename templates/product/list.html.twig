{% extends 'base.html.twig' %}

{% block title %}
Liste des produits
{% endblock %}

{% block body %}

<div class="list-card">

    <div class="list-header">

        <div>
            <h1>Produits</h1>
            <p>Liste des produits enregistrés</p>
        </div>

        <a
            href="{{ path('product_add') }}"
            class="btn-primary product-add-button"
            aria-label="Nouveau produit"
            title="Nouveau produit">
            <i class="bi bi-plus-lg" aria-hidden="true"></i>
            <span>Nouveau produit</span>
        </a>

    </div>

    <div class="table-wrapper">
        {% if is_granted('ROLE_ADMIN') %}
            <div id="product-table-filters" class="product-table-filters" hidden>
                <label for="product-supplier-filter">
                    <span>Fournisseur</span>
                    <select id="product-supplier-filter">
                        <option value="">Tous</option>
                        {% for fournisseur in fournisseurs %}
                            <option value="{{ fournisseur.id }}">
                                {% if fournisseur.libelle %}{{ fournisseur.libelle }} - {% endif %}
                                {{ fournisseur.prenom }} {{ fournisseur.nom }}
                            </option>
                        {% endfor %}
                    </select>
                </label>

                <button
                    type="button"
                    class="product-clear-filters"
                    id="product-clear-filters"
                    title="Réinitialiser les filtres"
                    aria-label="Réinitialiser les filtres">
                    <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                </button>
            </div>
        {% endif %}

        <table id="products-table" class="user-table product-table" data-url="{{ path('product_list', { datatable: 1 }) }}" data-is-admin="{{ is_granted('ROLE_ADMIN') ? 1 : 0 }}" data-placeholder="{{ asset('images/product-placeholder.jpg') }}" data-image-base="{{ asset(product_images_public_path) }}">

            <thead>
                <tr>
                    <th>Image</th>
                    <th>Libellé</th>
                    <th>Prix</th>
                    <th>Stock total</th>
                    <th>Stock restant</th>

                    {% if is_granted('ROLE_ADMIN') %}
                        <th>Fournisseur</th>
                    {% endif %}

                    <th></th>
                </tr>
            </thead>

        </table>
    </div>

</div>

<div
    id="product-restock-modal"
    class="product-restock-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="product-restock-title"
    hidden>
    <div class="product-restock-dialog">
        <button
            type="button"
            class="product-details-close"
            id="close-product-restock"
            aria-label="Fermer">
            <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>

        <div class="product-restock-header">
            <p>Gestion du stock</p>
            <h2 id="product-restock-title">Réapprovisionner</h2>
            <span id="product-restock-name"></span>
        </div>

        <form id="product-restock-form" method="post">
            <input type="hidden" name="_token" id="product-restock-token">

            <div class="form-group" id="product-restock-variation-field">
                <label for="product-restock-variation">Variation</label>
                <select
                    id="product-restock-variation"
                    name="variation"
                    required></select>
            </div>

            <div class="product-restock-selected" hidden>
                <span>Variation</span>
                <strong id="product-restock-selected-label"></strong>
            </div>

            <p class="product-restock-current">
                Stock disponible :
                <strong id="product-restock-current-stock">0</strong>
            </p>

            <div class="form-group">
                <label for="product-restock-quantity">Quantité à ajouter</label>
                <input
                    type="number"
                    id="product-restock-quantity"
                    name="quantite"
                    min="1"
                    value="1"
                    required>
            </div>

            <div class="form-group">
                <label for="product-restock-comment">
                    Commentaire <span>(facultatif)</span>
                </label>
                <textarea
                    id="product-restock-comment"
                    name="commentaire"
                    rows="3"
                    maxlength="500"
                    placeholder="Exemple : livraison fournisseur du jour"></textarea>
            </div>

            <div class="product-restock-actions">
                <button
                    type="button"
                    class="btn-secondary"
                    id="cancel-product-restock">
                    Annuler
                </button>
                <button type="submit" class="btn-primary">
                    <span class="button-label">Ajouter au stock</span>
                    <span class="button-loading" hidden>Enregistrement...</span>
                </button>
            </div>
        </form>
    </div>
</div>

<div
    id="product-details-modal"
    class="product-details-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="product-details-title"
    hidden>
    <div class="product-details-dialog">
        <button
            type="button"
            class="product-details-close"
            id="close-product-details"
            aria-label="Fermer">
            <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>

        <div id="product-details-content" aria-live="polite"></div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}

    <script src="{{ asset('vendor/jquery/jquery-3.7.1.min.js') }}"></script>
    <script src="{{ asset('vendor/datatables/dataTables.min.js') }}"></script>
    <script src="{{ asset('js/product.js') }}"></script>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    <link rel="stylesheet" href="{{ asset('vendor/datatables/dataTables.dataTables.min.css') }}">
{% endblock %}
