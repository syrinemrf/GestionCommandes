<div class="row-actions-menu">
    <button
        type="button"
        class="row-actions-trigger"
        aria-label="Afficher les actions du produit"
        aria-haspopup="menu"
        aria-expanded="false">&hellip;</button>

    <div class="row-actions-dropdown" role="menu" hidden>
        <button
            type="button"
            class="row-action-item product-details-button"
            data-url="{{ path('product_details', {'id': product.id}) }}"
            role="menuitem">
            Détails
        </button>

        <a
            href="{{ path('product_edit', {'id': product.id}) }}"
            class="row-action-item"
            role="menuitem">
            Modifier
        </a>

        {% if variations is not empty %}
            <button
                type="button"
                class="row-action-item product-restock-button"
                data-url="{{ path('product_restock', {'id': product.id}) }}"
                data-token="{{ csrf_token('product-restock-' ~ product.id) }}"
                data-product-label="{{ product.libelle }}"
                data-variations="{{ variations|json_encode|e('html_attr') }}"
                role="menuitem">
                Réapprovisionner
            </button>
        {% endif %}

        <form
            method="post"
            action="{{ path('product_delete', {'id': product.id}) }}"
            class="delete-product-form">
            <input
                type="hidden"
                name="_token"
                value="{{ csrf_token('delete-product-' ~ product.id) }}">
            <button
                type="submit"
                class="row-action-item row-action-danger"
                role="menuitem">
                Supprimer
            </button>
        </form>
    </div>
</div>
