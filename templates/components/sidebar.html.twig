<aside class="sidebar">

    <div class="logo">
        <a href="{{ path('app_home') }}">
            Commandes+
        </a>
    </div>

    <nav>

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('user_list') }}">
                <i class="bi bi-people"></i>
                <span>Utilisateurs</span>
            </a>
        {% endif %}

        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_FOURNISSEUR') %}
            <a href="{{ path('product_list') }}">
                <i class="bi bi-box-seam"></i>
                <span>Produits</span>
            </a>

            <a href="{{ path('commande_list') }}">
                <i class="bi bi-receipt"></i>
                <span>Commandes</span>
            </a>
        {% endif %}

    </nav>

    {% if app.user %}
        <div class="sidebar-footer">
            <a
                href="{{ path('app_profile') }}"
                class="sidebar-profile{% if app.request.attributes.get('_route') == 'app_profile' %} is-active{% endif %}"
                aria-label="Modifier mon profil">
                <div class="user-info">
                    <p class="user-name">{{ app.user.prenom }} {{ app.user.nom }}</p>
                    <p class="user-role">
                        {% if app.user.role == 'ROLE_ADMIN' %}
                            Administrateur
                        {% else %}
                            {{ app.user.libelle }}
                        {% endif %}
                    </p>
                </div>

                <span class="sidebar-profile-action" title="Modifier mon profil">
                    <i class="bi bi-pencil-square" aria-hidden="true"></i>
                </span>
            </a>
        </div>
    {% endif %}

</aside>
