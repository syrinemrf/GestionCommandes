{% extends 'base.html.twig' %}

{% block title %}Accueil - Komdely{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/home-authenticated.css') }}?v=20260813-1">
{% endblock %}

{% block body %}
{% set isAdmin = is_granted('ROLE_ADMIN') %}
<div class="authenticated-home">
    <section class="home-welcome-card">
        <div>
            <span class="home-welcome-eyebrow">
                {{ isAdmin ? 'Espace administrateur' : app.user.libelle|default('Espace fournisseur') }}
            </span>
            <h1>Bonjour {{ app.user.prenom }},</h1>
            <p>
                {% if isAdmin %}
                    Retrouvez un aperçu rapide de l’activité générale de Komdely.
                {% else %}
                    Voici les dernières informations utiles de votre espace Komdely.
                {% endif %}
            </p>
        </div>
    </section>

    <section class="home-panel home-activity-panel">
            <header class="home-panel-header">
                <div>
                    <h2>Dernières activités</h2>
                    <p>Les opérations les plus récentes de votre espace.</p>
                </div>
            </header>

            {% if home.activities is empty %}
                <div class="home-empty-state">
                    <i class="bi bi-clock-history" aria-hidden="true"></i>
                    <strong>Aucune activité récente</strong>
                    <span>Les nouvelles opérations apparaîtront ici.</span>
                </div>
            {% else %}
                <div class="home-activity-list">
                    {% for activity in home.activities %}
                        <a href="{{ path(activity.route) }}" class="home-activity-item">
                            <span class="home-activity-icon home-activity-icon-{{ activity.type }}">
                                <i class="bi bi-{{ activity.icon }}" aria-hidden="true"></i>
                            </span>
                            <span class="home-activity-content">
                                <strong>{{ activity.title }}</strong>
                                <small>{{ activity.detail }}</small>
                            </span>
                            <time datetime="{{ activity.date|date('c') }}">
                                {{ activity.date|date('d/m/Y H:i') }}
                            </time>
                            <i class="bi bi-chevron-right home-activity-arrow" aria-hidden="true"></i>
                        </a>
                    {% endfor %}
                </div>
            {% endif %}
    </section>
</div>
{% endblock %}
