<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Étiquette colis CMD-{{ '%06d'|format(commande.numero) }}</title>
    <style>
        @page { margin: 0; }
        * { box-sizing: border-box; }
        html, body { margin: 0; padding: 0; }
        body {
            color: #111827;
            font-family: "DejaVu Sans", sans-serif;
            font-size: 9pt;
        }
        .label-sheet {
            position: relative;
            width: 88mm;
            height: 138mm;
            margin: 5mm;
            border: 1.5px solid #111827;
        }
        .top {
            padding: 3.5mm 4mm;
            border-bottom: 1.5px solid #111827;
        }
        .brand {
            padding-right: 24mm;
            font-size: 13pt;
            font-weight: bold;
            overflow-wrap: break-word;
        }
        .parcel { float: right; font-size: 11pt; font-weight: bold; }
        .reference {
            padding: 3.5mm 4mm;
            border-bottom: 1.5px solid #111827;
            text-align: center;
        }
        .reference span { display: block; font-size: 8pt; text-transform: uppercase; }
        .reference strong { font-size: 19pt; letter-spacing: .03em; }
        .section {
            padding: 3.5mm 4mm;
            border-bottom: 1px solid #9ca3af;
            overflow-wrap: break-word;
        }
        .section-title {
            margin-bottom: 2mm;
            color: #4b5563;
            font-size: 8pt;
            font-weight: bold;
            letter-spacing: .08em;
            text-transform: uppercase;
        }
        .recipient { font-size: 13pt; font-weight: bold; line-height: 1.2; }
        .address { margin-top: 2.5mm; font-size: 10.5pt; line-height: 1.35; }
        .phone { margin-top: 3mm; font-size: 10.5pt; font-weight: bold; }
        .sender { font-size: 8.5pt; line-height: 1.3; }
        .footer {
            position: absolute;
            right: 4mm;
            bottom: 3mm;
            left: 4mm;
            color: #6b7280;
            font-size: 8pt;
            text-align: center;
        }
    </style>
</head>
<body>
    {% set fournisseur = commande.fournisseur %}
    {% set client = commande.client %}
    {% set fournisseurNom = fournisseur.libelle
        ?: [fournisseur.prenom, fournisseur.nom]|filter(value => value)|join(' ') %}
    {% set clientNom = client
        ? ([client.prenom, client.nom]|filter(value => value)|join(' ')
            ?: client.societe)
        : null %}

    <div class="label-sheet">
        <div class="top">
            <span class="parcel">Colis 1/1</span>
            <div class="brand">{{ fournisseurNom|default('Expéditeur') }}</div>
        </div>

        <div class="reference">
            <span>Commande</span>
            <strong>CMD-{{ '%06d'|format(commande.numero) }}</strong>
        </div>

        <div class="section sender">
            <div class="section-title">Expéditeur</div>
            <strong>{{ fournisseurNom|default('Non renseigné') }}</strong><br>
            {{ [fournisseur.prenom, fournisseur.nom]|filter(value => value)|join(' ') }}
            {% if fournisseur.email %}<br>{{ fournisseur.email }}{% endif %}
        </div>

        <div class="section">
            <div class="section-title">Destinataire</div>
            <div class="recipient">{{ clientNom|default('Non renseigné') }}</div>
            {% if client and client.societe and client.societe != clientNom %}
                <div>{{ client.societe }}</div>
            {% endif %}

            <div class="address">
                {% if client and client.rue %}{{ client.rue }}<br>{% endif %}
                {% if client and client.complementAdresse %}{{ client.complementAdresse }}<br>{% endif %}
                {% if client and (client.codePostal or client.ville) %}
                    {{ [client.codePostal, client.ville]|filter(value => value)|join(' ') }}
                {% else %}
                    Adresse non renseignée
                {% endif %}
            </div>

            <div class="phone">
                Tél. {{ client and client.telephone
                    ? client.telephone
                    : 'Non renseigné' }}
            </div>
        </div>

        <div class="footer">
            Étiquette logistique · {{ commande.date|date('d/m/Y') }}
        </div>
    </div>
</body>
</html>
