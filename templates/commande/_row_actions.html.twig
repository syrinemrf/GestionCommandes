<div class="row-actions-menu">
    <button
        type="button"
        class="row-actions-trigger"
        aria-label="Afficher les actions de la commande"
        aria-haspopup="menu"
        aria-expanded="false">&hellip;</button>

    <div class="row-actions-dropdown" role="menu" hidden>
        <button
            type="button"
            class="row-action-item commande-details-button"
            data-url="{{ path('commande_details', {id: commande.id}) }}"
            role="menuitem">
            Détails
        </button>

        {% if commande.modifiable %}
            <a
                href="{{ path('commande_edit', {id: commande.id}) }}"
                class="row-action-item"
                role="menuitem">
                Modifier
            </a>
        {% endif %}

        <form
            method="post"
            action="{{ path('commande_delete', {id: commande.id}) }}"
            class="delete-commande-form">
            <input
                type="hidden"
                name="_token"
                value="{{ csrf_token('commande-delete-' ~ commande.id) }}">
            <button
                type="submit"
                class="row-action-item row-action-danger"
                role="menuitem">
                Supprimer
            </button>
        </form>
    </div>
</div>
