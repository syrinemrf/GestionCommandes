{% extends 'base.html.twig' %}

{% block title %}Tableau de bord - Komdely{% endblock %}

{% block body %}
<div
    id="supplier-dashboard"
    class="dashboard"
    data-summary-url="{{ path('analytics_summary') }}"
    data-evolution-url="{{ path('analytics_evolution') }}"
    data-products-url="{{ path('analytics_products') }}"
    data-statuses-url="{{ path('analytics_statuses') }}"
    data-stock-url="{{ path('analytics_stock') }}"
    data-risks-url="{{ path('analytics_risks') }}"
    data-risk-explanation-url="{{ path('analytics_risks') }}">

    <header class="dashboard-header">
        <div>
            <h1>Tableau de bord</h1>
            <p>Suivez l'activité de vos commandes, produits et stocks.</p>
        </div>

        <div class="dashboard-refresh-info" aria-live="polite">
            <span class="dashboard-refresh-label">Dernière mise à jour des données</span>
            <strong id="dashboard-last-updated">Aucune actualisation</strong>
        </div>
    </header>

    <section class="dashboard-filters" aria-label="Filtres du tableau de bord">
        <label>
            <span>Du</span>
            <input type="date" id="dashboard-date-from">
        </label>
        <label>
            <span>Au</span>
            <input type="date" id="dashboard-date-to">
        </label>
        <button type="button" class="btn-primary dashboard-apply" id="dashboard-apply-filters">
            Appliquer
        </button>
        <button type="button" class="btn-secondary dashboard-period" data-period-days="30">30 jours</button>
        <button type="button" class="btn-secondary dashboard-period" data-period-days="90">90 jours</button>
        <button type="button" class="btn-secondary dashboard-period" data-period-days="365">12 mois</button>

        <label class="dashboard-auto-refresh">
            <span>Actualisation auto.</span>
            <select id="dashboard-refresh-interval">
                <option value="0">Désactivée</option>
                <option value="60">Chaque minute</option>
                <option value="300" selected>Toutes les 5 min</option>
                <option value="900">Toutes les 15 min</option>
            </select>
        </label>

        <button type="button" class="dashboard-refresh-button" id="dashboard-refresh" aria-label="Actualiser maintenant">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
            <span>Actualiser</span>
        </button>
    </section>

    <div id="dashboard-feedback" class="dashboard-feedback" role="status" aria-live="polite" hidden></div>

    <section class="dashboard-kpis" aria-label="Indicateurs clés">
        {% set cards = {
            'orders': ['Commandes', '0'],
            'revenue-ht': ['Chiffre d’affaires HT', '0,000 TND'],
            'revenue-ttc': ['Chiffre d’affaires TTC', '0,000 TND'],
            'average-basket': ['Panier moyen HT', '0,000 TND'],
            'cancellation-rate': ['Taux d’annulation', '0 %']
        } %}
        {% for key, card in cards %}
            <article class="dashboard-kpi-card">
                <span>{{ card[0] }}</span>
                <strong id="kpi-{{ key }}">{{ card[1] }}</strong>
            </article>
        {% endfor %}
    </section>

    <section class="dashboard-grid">
        <article class="dashboard-panel dashboard-panel-wide">
            <div class="dashboard-panel-heading">
                <div>
                    <h2>Évolution de l’activité</h2>
                    <p>Commandes et chiffre d’affaires HT</p>
                </div>
            </div>
            <div class="dashboard-chart" id="dashboard-evolution-chart" role="img" aria-label="Évolution des commandes et du chiffre d’affaires"></div>
            <div class="dashboard-empty" data-empty-for="evolution" hidden>Aucune activité sur cette période.</div>
        </article>

        <article class="dashboard-panel">
            <div class="dashboard-panel-heading">
                <div>
                    <h2>Répartition des statuts</h2>
                    <p>État actuel des commandes</p>
                </div>
            </div>
            <div class="dashboard-chart dashboard-chart-compact" id="dashboard-status-chart" role="img" aria-label="Répartition des statuts des commandes"></div>
            <div class="dashboard-empty" data-empty-for="statuses" hidden>Aucune commande à répartir.</div>
        </article>

        <article class="dashboard-panel dashboard-panel-wide">
            <div class="dashboard-panel-heading">
                <div>
                    <h2>Produits les plus performants</h2>
                    <p>Unités vendues par produit et variation</p>
                </div>
            </div>
            <div class="dashboard-chart dashboard-chart-products" id="dashboard-products-chart" role="img" aria-label="Produits et variations les plus performants"></div>
            <div class="dashboard-empty" data-empty-for="products" hidden>Aucune vente sur cette période.</div>
        </article>

        <article class="dashboard-panel dashboard-stock-panel">
            <div class="dashboard-panel-heading">
                <div>
                    <h2>Stock disponible</h2>
                    <p>Variations nécessitant votre attention en premier</p>
                </div>
            </div>
            <div class="dashboard-stock-wrapper">
                <table class="dashboard-stock-table">
                    <thead>
                        <tr>
                            <th>Produit</th>
                            <th>Disponible</th>
                            <th>Réservé</th>
                            <th>État</th>
                        </tr>
                    </thead>
                    <tbody id="dashboard-stock-body"></tbody>
                </table>
            </div>
            <div class="dashboard-empty" data-empty-for="stock" hidden>Aucune donnée de stock disponible.</div>
        </article>

        <article class="dashboard-panel dashboard-panel-full dashboard-risk-panel">
            <div class="dashboard-panel-heading dashboard-risk-heading">
                <div>
                    <h2>Risques de stock prévus</h2>
                    <p>Prévisions à 7 jours. Elles aident à décider, sans modifier automatiquement votre stock.</p>
                </div>
                <label class="dashboard-risk-filter">
                    <span>Niveau de risque</span>
                    <select id="dashboard-risk-level">
                        <option value="">Tous les niveaux</option>
                        <option value="HIGH">Élevé</option>
                        <option value="MEDIUM">Modéré</option>
                        <option value="LOW">Faible</option>
                        <option value="INSUFFICIENT_DATA">Données insuffisantes</option>
                    </select>
                </label>
            </div>
            <div class="dashboard-risk-wrapper">
                <table class="dashboard-risk-table">
                    <thead>
                        <tr>
                            <th>Produit / variation</th>
                            <th>Risque</th>
                            <th>Prévision</th>
                            <th>q90</th>
                            <th>Stock</th>
                            <th>Recommandation</th>
                            <th>Demande récente</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="dashboard-risk-body"></tbody>
                </table>
            </div>
            <div class="dashboard-empty" data-empty-for="risks" hidden>Aucune prédiction pour ce filtre.</div>
        </article>
    </section>

    <dialog class="dashboard-xai-dialog" id="dashboard-xai-dialog" aria-labelledby="dashboard-xai-title">
        <div class="dashboard-xai-header">
            <div>
                <span class="dashboard-xai-eyebrow">Explication de la prévision</span>
                <h2 id="dashboard-xai-title">Pourquoi ce risque ?</h2>
            </div>
            <button type="button" id="dashboard-xai-close" aria-label="Fermer">×</button>
        </div>
        <div id="dashboard-xai-loading" class="dashboard-xai-state">Chargement de l’explication…</div>
        <div id="dashboard-xai-content" hidden>
            <p id="dashboard-xai-product" class="dashboard-xai-product"></p>
            <dl class="dashboard-xai-metrics">
                <div><dt>Stock disponible</dt><dd id="dashboard-xai-stock">—</dd></div>
                <div><dt>Prévision centrale</dt><dd id="dashboard-xai-central">—</dd></div>
                <div><dt>Prévision q90</dt><dd id="dashboard-xai-q90">—</dd></div>
                <div><dt>Déficit central</dt><dd id="dashboard-xai-deficit">—</dd></div>
                <div><dt>Risque</dt><dd id="dashboard-xai-risk">—</dd></div>
                <div><dt>Quantité recommandée</dt><dd id="dashboard-xai-recommendation">—</dd></div>
            </dl>
            <section class="dashboard-xai-factors">
                <h3>Facteurs qui contribuent à la prévision q90</h3>
                <p>Une contribution décrit l’influence du modèle ; elle ne prouve pas une cause de rupture.</p>
                <div id="dashboard-xai-chart" class="dashboard-xai-chart"></div>
                <div id="dashboard-xai-no-shap" class="dashboard-xai-state" hidden>Aucune explication SHAP disponible pour cette prédiction.</div>
            </section>
            <footer class="dashboard-xai-meta">
                <span>Modèle : <strong id="dashboard-xai-model">—</strong></span>
                <span>Prédiction : <strong id="dashboard-xai-date">—</strong></span>
            </footer>
        </div>
    </dialog>

    <div class="dashboard-initial-loader" id="dashboard-loader" aria-label="Chargement du tableau de bord">
        <span class="dashboard-spinner" aria-hidden="true"></span>
        <span>Chargement des indicateurs…</span>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('vendor/echarts/echarts.min.js') }}"></script>
    <script src="{{ asset('js/dashboard.js') }}"></script>
{% endblock %}
