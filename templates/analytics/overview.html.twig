{% extends 'base.html.twig' %}

{% block title %}Vue d’ensemble - Komdely{% endblock %}

{% block body %}
<div id="supplier-dashboard" class="dashboard" data-overview-url="{{ path('analytics_overview') }}" data-evolution-url="{{ path('analytics_evolution') }}" data-products-url="{{ path('analytics_product_comparison') }}" data-statuses-url="{{ path('analytics_statuses') }}" data-stock-url="{{ path('analytics_stock') }}" data-risks-url="{{ path('analytics_risks') }}" data-orders-url="{{ path('commande_list') }}">
    {% include 'analytics/_header.html.twig' with {title: 'Vue d’ensemble', subtitle: 'Les indicateurs essentiels pour piloter votre activité.'} %}
    {% include 'analytics/_navigation.html.twig' %}

    <section class="dashboard-filters" aria-label="Période analysée">
        <label><span>Du</span><input type="date" id="dashboard-date-from"></label>
        <label><span>Au</span><input type="date" id="dashboard-date-to"></label>
        <button type="button" class="btn-primary" id="dashboard-apply-filters">Appliquer</button>
        <button type="button" class="btn-secondary dashboard-period" data-period-days="30">30 jours</button>
        <button type="button" class="btn-secondary dashboard-period" data-period-days="90">90 jours</button>
        <button type="button" class="btn-secondary dashboard-period" data-period-days="365">12 mois</button>
        <label class="dashboard-auto-refresh"><span>Actualisation auto.</span><select id="dashboard-refresh-interval"><option value="0">Désactivée</option><option value="60">Chaque minute</option><option value="300" selected>Toutes les 5 min</option><option value="900">Toutes les 15 min</option></select></label>
        <button type="button" class="dashboard-refresh-button" id="dashboard-refresh"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i><span>Actualiser</span></button>
    </section>
    <div id="dashboard-feedback" class="dashboard-feedback" role="status" aria-live="polite" hidden></div>

    <section class="dashboard-kpis dashboard-progressive-section" data-dashboard-section="overview" aria-label="Indicateurs clés">
        {% set cards = {'orders': 'Commandes', 'revenue': 'Chiffre d’affaires HT', 'average-basket': 'Panier moyen HT', 'cancellation': 'Taux d’annulation', 'processing': 'Délai moyen de traitement'} %}
        {% for key, label in cards %}
            <article class="dashboard-kpi-card"><span>{{ label }}</span><strong id="kpi-{{ key }}">-</strong><small id="kpi-{{ key }}-comparison" class="dashboard-kpi-comparison is-neutral">Comparaison indisponible</small></article>
        {% endfor %}
    </section>
    <div class="dashboard-section-error" data-error-for="overview" hidden></div>

    <section class="dashboard-overview-primary-grid">
        <article class="dashboard-panel dashboard-overview-chart-panel dashboard-progressive-section" data-dashboard-section="evolution">
            <div class="dashboard-panel-heading"><div><h2>Évolution de l’activité</h2><p id="dashboard-evolution-subtitle">Commandes et chiffre d’affaires HT</p></div></div>
            <div class="dashboard-chart dashboard-chart-main" id="dashboard-evolution-chart" role="img" aria-label="Évolution des commandes et du chiffre d’affaires"></div>
            <div class="dashboard-section-loading" data-loading-for="evolution"><span class="dashboard-spinner"></span><span>Chargement de l’évolution...</span></div>
            <div class="dashboard-section-error" data-error-for="evolution" hidden></div>
            <div class="dashboard-empty" data-empty-for="evolution" hidden>Aucune activité sur cette période.</div>
        </article>
        <article class="dashboard-panel dashboard-compact-panel dashboard-progressive-section" data-dashboard-section="statuses">
            <div class="dashboard-panel-heading"><div><h2>Commandes à traiter</h2><p>Situation actuelle</p></div></div>
            <strong id="dashboard-action-total" class="dashboard-action-total" hidden>-</strong>
            <div id="dashboard-status-list" class="dashboard-action-list"></div>
            <p id="dashboard-transit-total" class="dashboard-transit-total" hidden></p>
            <div class="dashboard-section-loading" data-loading-for="statuses"><span class="dashboard-spinner"></span><span>Chargement...</span></div>
            <div class="dashboard-section-error" data-error-for="statuses" hidden></div>
            <div class="dashboard-empty dashboard-empty-compact" data-empty-for="statuses" hidden>Aucune commande ne nécessite votre attention.</div>
        </article>
    </section>

    <section class="dashboard-overview-secondary-grid">
        <article class="dashboard-panel dashboard-performance-panel dashboard-progressive-section" data-dashboard-section="products">
            <div class="dashboard-panel-heading dashboard-performance-heading">
                <div><h2>Performance des produits</h2><p>Comparée à la période précédente de même durée</p></div>
                <a href="{{ path('analytics_dashboard_products') }}" class="dashboard-text-link">Voir le stock</a>
            </div>
            <div class="dashboard-performance-tabs" role="tablist" aria-label="Classement des produits">
                <button type="button" class="is-active" role="tab" aria-selected="true" data-product-mode="revenue">Top CA</button>
                <button type="button" role="tab" aria-selected="false" data-product-mode="units">Plus vendus</button>
                <button type="button" role="tab" aria-selected="false" data-product-mode="declining">En baisse</button>
            </div>
            <div class="dashboard-performance-columns" aria-hidden="true"><span>Produit</span><span>CA HT</span><span>Unités</span><span>Évolution</span></div>
            <ol id="dashboard-top-products" class="dashboard-performance-list"></ol>
            <div class="dashboard-section-loading" data-loading-for="products"><span class="dashboard-spinner"></span><span>Chargement...</span></div>
            <div class="dashboard-section-error" data-error-for="products" hidden></div>
            <div class="dashboard-empty dashboard-empty-compact" data-empty-for="products" hidden>Aucune donnée pour ce classement.</div>
        </article>
        <article class="dashboard-panel dashboard-compact-panel dashboard-alert-panel dashboard-progressive-section" data-dashboard-section="alerts"><div class="dashboard-panel-heading"><div><h2>À surveiller</h2><p>5 alertes prioritaires maximum</p></div></div><ul id="dashboard-alerts" class="dashboard-alert-list"></ul><div class="dashboard-section-loading" data-loading-for="alerts"><span class="dashboard-spinner"></span><span>Analyse des alertes...</span></div><div class="dashboard-section-error" data-error-for="alerts" hidden></div><div class="dashboard-empty dashboard-empty-compact" data-empty-for="alerts" hidden>Aucune alerte prioritaire.</div></article>
    </section>

</div>
{% endblock %}

{% block javascripts %}{{ parent() }}<script src="{{ asset('vendor/echarts/echarts.min.js') }}"></script><script src="{{ asset('js/dashboard-common.js') }}?v=20260812-1"></script><script src="{{ asset('js/dashboard-overview.js') }}?v=20260812-1"></script>{% endblock %}
